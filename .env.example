# Адрес self-hosted vLLM; аудио и текст нельзя отправлять облачным провайдерам.
LLM_BASE_URL=http://127.0.0.1:8000/v1
# Имя модели проверяется по /v1/models на сервере.
LLM_MODEL=qwen3.8-27b
# Каталог локального кэша моделей.
HF_HOME=.cache/huggingface
# Кэши Compose на хосте, необязательно; по умолчанию .cache/llm и .cache/asr.
# LLM_CACHE_DIR=/absolute/path/to/llm-cache
# ASR_CACHE_DIR=/absolute/path/to/asr-cache
# Режим локального веб-сервера, по умолчанию replay; в Compose фиксирован gpu.
APP_MODE=replay
# Каталог сохранённых протоколов (JSON) для страницы «История», по умолчанию outputs/protocols.
# PROTOCOL_DIR=/absolute/path/to/protocols
