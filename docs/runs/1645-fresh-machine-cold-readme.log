# Cold run of README commands (sections 1 and 2) on a new Brev machine eldest-yellow-basilisk (g7e.2xlarge, 0 docker images, no uv before the run). Repo cloned from a git bundle of main (GitHub repo is private). Runner script below, then its full output.
# --- runner script ---
#!/usr/bin/env bash
# Cold-start run of README commands on a clean machine; every step timestamped.
set -uo pipefail
step() { echo; echo "=== $(date '+%F %T %Z') \$ $*"; start=$SECONDS; "$@"; rc=$?; echo "=== rc=$rc, $((SECONDS-start))s"; [[ $rc == 0 ]] || { echo "FAILED: $*"; exit $rc; }; }
echo "host: $(hostname); docker images: $(docker images -q | wc -l)"
cd ~
rm -rf fresh && git clone --quiet ~/repo.bundle fresh && cd fresh && git checkout --quiet main
echo "commit: $(git rev-parse HEAD)"
# README section 1 prerequisite: uv 0.12.18
step bash -c 'curl -LsSf https://astral.sh/uv/0.12.18/install.sh | sh'
export PATH="$HOME/.local/bin:$PATH"
step uv --version
# README section 1: replay
step uv sync --locked
step uv run --locked python -m meeting_protocol 'docs/Трек 8 Инновации/Совещание №1.mp3' --output outputs/meeting-1
step uv run --locked python -m meeting_protocol 'docs/Трек 8 Инновации/Совещание №2.mp3' --output outputs/meeting-2
step ls -la outputs
# README section 2: GPU path
step mkdir -p outputs
step docker compose build app
step docker compose up -d --wait --wait-timeout 900 llm
step docker compose run --rm app -m meeting_protocol 'docs/Трек 8 Инновации/Совещание №1.mp3' --mode gpu --date 2026-09-23 --output outputs/meeting-1
step docker compose run --rm app -m meeting_protocol 'docs/Трек 8 Инновации/Совещание №2.mp3' --mode gpu --date 2026-09-23 --output outputs/meeting-2
step docker compose run --rm app scripts/verify_outputs.py
step docker compose up -d app
step bash -c 'sleep 20; curl -fsS -o /dev/null -w "web %{http_code}\n" http://127.0.0.1:8001/'
echo "COLD RUN PASS $(date '+%F %T %Z')"
